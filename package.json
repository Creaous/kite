{
  "name": "kite-monorepo",
  "private": true,
  "scripts": {
    "build": ". ./.do-not-track && turbo run build",
    "dev": ". ./.do-not-track && turbo run dev",
    "lint": ". ./.do-not-track && turbo run lint",
    "format": ". ./.do-not-track && prettier --write \"**/*.{ts,tsx,md,html,svelte}\"",
    "check": ". ./.do-not-track && turbo run check",
    "version:app": "node -p \"require('./apps/kite/package.json').version\"",
    "version:app:patch": "npm --prefix apps/kite version patch --no-git-tag-version",
    "version:app:minor": "npm --prefix apps/kite version minor --no-git-tag-version",
    "version:app:major": "npm --prefix apps/kite version major --no-git-tag-version"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.20",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  }
}
