{
	"name": "kite",
	"description": "A self-hosted file-sharing application built with SvelteKit and PostgreSQL (Drizzle ORM).",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"start": "node build",
		"start:container": "node scripts/start-app.mjs",
		"worker": "node scripts/worker.mjs",
		"worker:example": "node scripts/worker-example.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up -d",
		"prod:up": "docker compose -f docker-compose.prod.yml up --build -d",
		"prod:up:worker": "docker compose -f docker-compose.prod.yml --profile worker up --build -d",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "pnpx https://pkg.pr.new/better-auth/better-auth/@better-auth/cli@6913 generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.ts --yes",
		"openapi:generate": "node scripts/generate-openapi.mjs"
	},
	"devDependencies": {
		"@better-auth/drizzle-adapter": "https://pkg.pr.new/better-auth/better-auth/@better-auth/drizzle-adapter@6913",
		"@better-auth/passkey": "1.5.5",
		"@electric-sql/pglite": "^0.4.0",
		"@electric-sql/pglite-socket": "^0.1.0",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@iconify/svelte": "^5.2.1",
		"@inlang/paraglide-js": "^2.15.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.5.0",
		"@types/nodemailer": "^7.0.11",
		"@types/pg": "^8.18.0",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "4.1.0",
		"better-auth": "1.5.5",
		"daisyui": "^5.5.19",
		"drizzle-kit": "1.0.0-beta.17-67b1795",
		"drizzle-orm": "1.0.0-beta.17-67b1795",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.5",
		"swagger-jsdoc": "^6.2.8",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^8.0.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.1.0",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"bullmq": "^5.71.0",
		"dotenv": "^17.3.1",
		"fflate": "^0.8.2",
		"ioredis": "^5.10.0",
		"jose": "^6.2.2",
		"nodemailer": "^8.0.3",
		"pg": "^8.20.0"
	}
}
