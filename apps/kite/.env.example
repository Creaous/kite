# Core app
NODE_ENV="production"
ORIGIN="http://localhost:3000"

# Database / queue
DATABASE_URL="postgres://kite:kite@localhost:5432/kite"
REDIS_URL="redis://localhost:6379"

# Startup / migration behavior
RUN_DB_MIGRATIONS="true"
DB_CONNECT_MAX_RETRIES="60"
DB_CONNECT_RETRY_DELAY_MS="2000"
DB_MIGRATE_MAX_ATTEMPTS="5"
DRIZZLE_MIGRATIONS_DIR="./drizzle"

# Worker settings
UNUSED_UPLOAD_EXPIRY_MINUTES="60"
SHARE_EXPIRY_SCAN_INTERVAL_MS="60000"
UNUSED_UPLOAD_SCAN_INTERVAL_MS="60000"

# Upload API limits
MAX_UPLOAD_SIZE_BYTES="5368709120"
MAX_UPLOAD_CHUNK_BYTES="8388608"

# Postgres container defaults
POSTGRES_DB="kite"
POSTGRES_USER="kite"
POSTGRES_PASSWORD="kite"

# Drizzle Gateway (required when using docker compose service)
DRIZZLE_GATEWAY_PORT="4983"
DRIZZLE_GATEWAY_MASTERPASS="change-me"

# Better Auth
# For production use 32+ chars generated with high entropy:
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Token signing (share/download/anonymous flows)
TOKEN_SECRET=""

# Server-side auth feature flags
ALLOW_EMAIL_AND_PASSWORD="true"
ALLOW_ANONYMOUS_USERS="false"
ALLOW_PASSKEYS="true"
ENABLE_INITIAL_SETUP="true"

# Public flags for auth client plugin parity
PUBLIC_ALLOW_ANONYMOUS_USERS="false"
PUBLIC_ALLOW_PASSKEYS="true"

# Optional social providers (enable by setting BOTH *_CLIENT_ID and *_CLIENT_SECRET)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Optional update check target (defaults to project repository)
UPDATE_REPOSITORY_URL="https://git.codeguilds.org/Mitchell/kite"

# Optional SMTP (required for share requests and auth emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional custom email template directory.
# Expected templates: share-request.html, reset-password.html, verify-email.html
EMAIL_TEMPLATES_DIR=""
 